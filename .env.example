# ── Provider ─────────────────────────────────────────────────────────────────
# Choose "anthropic" (default) or "gemini"
PROVIDER=anthropic

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-sonnet-4-6
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash-lite-preview-06-17

# ── Retrieval ─────────────────────────────────────────────────────────────────
# "banidb" (default) — live BaniDB search API; no corpus build or index needed.
# "local"            — hybrid dense+BM25 over a locally built corpus
#                      (requires python -m src.ingest + src.audit + src.embed).
RETRIEVAL_MODE=banidb
# Results requested per BaniDB search call
BANIDB_SEARCH_RESULTS=20
