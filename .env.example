# ── Provider ─────────────────────────────────────────────────────────────────
# Choose "anthropic" (default) or "gemini"
PROVIDER=anthropic

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-sonnet-4-6
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash-lite-preview-06-17

# ── Retrieval ─────────────────────────────────────────────────────────────────
# "local" (default) — full semantic RAG: hybrid dense+BM25 over the corpus
#                     built once from the BaniDB API
#                     (python -m src.ingest + src.audit + src.embed).
# "banidb"          — live BaniDB search API per question (lexical matching
#                     only; no index needed, but degraded retrieval quality).
RETRIEVAL_MODE=local
# Results requested per BaniDB search call (banidb mode / verification fallback)
BANIDB_SEARCH_RESULTS=20

# ── Spend protection ──────────────────────────────────────────────────────────
# Global daily cap on /ask requests across all clients (0 = unlimited)
DAILY_REQUEST_CAP=500
# Optional bearer token: when set, /ask requires "Authorization: Bearer <token>"
API_TOKEN=
# Set true ONLY behind a trusted reverse proxy (Railway/Cloud Run) so
# per-IP rate limiting uses X-Forwarded-For instead of the proxy IP
TRUST_PROXY=false
